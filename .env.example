# Listen address (loopback by default on purpose).
BIND=127.0.0.1
PORT=3000

# Require `Authorization: Bearer <token>` on every route but /health.
# AGENT_RUNTIME_TOKEN=change-me

# Only needed for the direct Messages API routes (/messages, /messages/complete).
# Agent runs use the `claude` CLI's own login.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Agent runs.
# CLAUDE_CLI_PATH=/usr/local/bin/claude
# AGENT_PERMISSION_MODE=acceptEdits
# AGENT_ALLOWED_TOOLS=Read,Glob,Grep
# AGENT_RUNTIME_ALLOW_CWD=0
# AGENT_MODEL=claude-opus-5-5

# Capacity. Each running turn is a `claude` process of a few hundred MB.
# AGENT_MAX_CONCURRENT=4        # turns at once; beyond this, 429
# AGENT_RUN_TIMEOUT_SECS=600    # per turn; beyond this, 504 and the process is killed
# AGENT_SESSION_TTL_SECS=300    # idle time before a kept session is reclaimed
# AGENT_MAX_SESSIONS=32         # kept sessions (idle-but-live processes)

# Log level.
RUST_LOG=agent_runtime=info
